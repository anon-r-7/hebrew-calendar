{
  "name": "hebrew-feasts",
  "version": "1.0.0",
  "main": "src/index.ts",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.20.0",
    "npm": "please-use-yarn"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rm -rf node_modules && rm -rf packages/*/node_modules && rm -rf .yarn/cache && rm yarn.lock && rm -rf packages/api/dist && rm packages/ui/build",
    "prettier": "prettier --check \"packages/**/src/**/*.ts\" && prettier --check \"packages/**/src/**/*.tsx\"",
    "prettier:fix": "prettier --write \"packages/**/src/**/*.ts\" --write \"packages/**/src/**/*.tsx\"",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "lint:fix": "eslint --fix packages/*/src --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:api": "jest --selectProjects api"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.10",
    "@babel/core": "^7.22.10",
    "@babel/node": "^7.22.10",
    "@babel/plugin-transform-runtime": "^7.15.0",
    "@babel/preset-env": "^7.22.10",
    "@babel/preset-typescript": "^7.22.5",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "babel-jest": "^29.1.2",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-react": "^7.24.0",
    "eslint-plugin-testing-library": "^4.12.0",
    "jest": "^29.1.2",
    "jest-environment-jsdom": "^29.1.2",
    "jest-transform-stub": "^2.0.0",
    "prettier": "^2.4.0",
    "ts-jest": "^29.0.5"
  },
  "packageManager": "yarn@3.2.1"
}
