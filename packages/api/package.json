{
  "name": "hebrew-feasts-api",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "scripts": {
    "build": "tsc && babel src --out-dir dist --extensions '.ts,.js' --source-maps",
    "start": "nodemon -r tsconfig-paths/register --exec ts-node --ext ts,js src/index.ts",
    "start:prod": "yarn build && yarn start",
    "serve": "node dist/index.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo:all",
    "db:migrate:undo:last": "npx sequelize-cli db:migrate:undo",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all",
    "prettier": "prettier --check \"src/**/**/*.ts*\"",
    "prettier:fix": "prettier --write \"src/**/**/*.ts*\"",
    "lint": "eslint ./src/ --ext .ts",
    "lint:fix": "eslint --fix src --ext .ts",
    "tsc": "tsc"
  },
  "dependencies": {
    "@hebcal/core": "^5.2.2",
    "@types/sequelize": "^4.28.20",
    "axios": "^1.6.7",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "isomorphic-unfetch": "^4.0.2",
    "js-yaml": "^4.1.0",
    "meeusjs": "^1.0.4",
    "meeussunmoon": "^3.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.11.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.1",
    "sequelize-cli": "^6.6.2",
    "tslib": "^2.6.2",
    "viem": "2.7.12",
    "winston": "3.8.2",
    "winston-daily-rotate-file": "4.7.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.4",
    "@babel/node": "^7.22.19",
    "@babel/preset-typescript": "^7.23.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.11",
    "@types/morgan": "^1.9.5",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.10.2",
    "@types/supertest": "^6.0.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.9.5"
  }
}
